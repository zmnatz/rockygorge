    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "9.4.0",
    "@paypal/react-paypal-js": "^7.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@zmnatz/usa-club-rugby-data": "^0.5.1",
    "js-yaml": "^5.2.3",
    "netlify-identity-widget": "^2.0.3",
    "octokit": "^5.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-react": "^8.0.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
