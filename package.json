    "netlify-plugin-cache": "^1.0.3",
    "next": "^16.3.0",
    "typescript": "^7.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.0",
    "yaml-loader": "^0.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mdx}": "biome check --no-errors-on-unmatched"
  },
  "trustedDependencies": [
    "esbuild",
    "unix-dgram"
  ]
