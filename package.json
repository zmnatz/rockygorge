    "generate": "bun run generate:scores; bun run generate:standings; bun run generate:players; bun run generate:leaders; bun run generate:club-pages; bun run generate:crests",
    "generate:force": "FORCE_SNAPSHOTS=1 bun run generate",
    "generate:players": "bun scripts/generate-players.ts",
    "generate:scores": "bun scripts/generate-scores-index.ts",
    "generate:standings": "bun scripts/generate-standings-index.ts",
    "generate:leaders": "bun scripts/generate-leaders-index.ts",
    "generate:crests": "bun scripts/generate-crests.ts",
    "generate:club-pages": "bun scripts/generate-club-pages.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not ie <= 11"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@next/mdx": "^16.3.0",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/netlify-identity-widget": "^1.9.7",
    "@types/qrcode": "^1.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
